$(function(){
	var api = new mw.Api();
	var version = [0, 1, 0]; // Para ter numeros de versões, junte numeros com os periodos. Por exemplo, "0, 0, 1" é  version 0.0.1
	var whatsnew = `Obrigado por usar a tradução de TheTechie's User Tools. Se quiser colaborar visite o GitHub: https://github.com/MiloLikeSkankUwU/TTUT-PT
Para ver o changelog para esta versão (v${version[0]}.${version[1]}.${version[2]}), favor vai em:
Usuário:Vitorperrut555/tut, já que ele não pode criar mais subpágina por motivos adminstrativos
`;
	mw.loader.using(['mediawiki.util', "mediawiki.api"], function () {
		class textBlocks {
			constructor(){
				this.smile = `
<br>
==Um sorriso para você!==
{{subst:smile}} ~~~~
				`;
				this.teahouse = `
<br>
==Um agradecimento!==
{{subst:Agradicmento}} ~~~~
				`;
				this.warninggeneric = `<br><!-- Este aviso foi gerado usando TTUT de Vitorperrut555/MiloLikeSkankUwU -->
''Este aviso foi gerado usando [[Usuário:Vitorperrut555/tut|Ferramentas de usuário de Milo]], e não é um aviso official.''<br>`
				this.warning1 = `<br>[[File:Information.svg|25px|alt=Information icon]] %WARNING% ~~~~`;
				this.warning2 = `<br>[[File:Information orange.svg|25px|alt=Information icon]] %WARNING% ~~~~`;
				this.warning3 = `<br>[[File:Nuvola apps important.svg|25px|alt=Warning icon]] %WARNING% ~~~~`;
				this.warning4 = `<br>[[File:Stop hand nuvola.svg|30px|alt=Stop icon]] %WARNING% ~~~~`;
			}
		}
		
		class editSummaries {
			constructor(){
				this.smile = "Enviando sorriso =) usando [[Usuário:Vitorperrut555/tut|Ferramentas de usuário de Milo]]";
				this.archive = "Arquivando esta página usando [[Usuário:Vitorperrut555/tut|Ferramentas de usuário de Milo]]";
				this.custom = "Criando um aviso personalizado [[Usuário:Vitorperrut555/tut|Ferramentas de usuário de Milo]]";
				this.teahouse = "Agradeçendo o usuário(a) usando [[Usuário:Vitorperrut555/tut|Ferramentas de usuário de Milo]]";
			}
		}
		
		blocks = new textBlocks();
		
		es = new editSummaries();
		
		function wait(secs) {
			let msecs = secs * 1000;
			setTimeout(function () {
        		location.reload();
    		}, msecs);
		}
		
		function replacePage( info ) {
			api.postWithToken("csrf", {
				action: 'edit',
				title: info.title,
				text: info.text, // Vai recoloar o conteúdo interio da página
				summary: info.summary
			} ).done(function( data ) {
				alert("Feito! Esta página vai recarregar em alguns segundos.");
			} ).fail( function(code, data) {
				alert(api.getErrorMessage(data).text());
			} );
		}
		
		function appendToPage( info ) {
			api.postWithToken("csrf", {
				action: 'edit',
				title: info.title,
				appendtext: info.text, // Vai recoloar o conteúdo interio da página
				summary: info.summary
			} ).done(function( data ) {
				alert("Feito! Esta página vai recarregar em alguns segundos..");
			} ).fail( function(code, data) {
				alert(api.getErrorMessage(data).text());
			} );
		}
		
		function smileAtUser(){
			if ( mw.config.get( 'wgCanonicalNamespace' ) === 'User_talk') {
				if (confirm("Gostaria de enviar um sorriso?")) {
					appendToPage({
						title: mw.config.get('wgPageName'),
						text: blocks.smile,
						summary: es.smile
					});
					wait(3);
				}
			}
			
			else {
				alert("TTUT: Esta ferramenta só pode ser usada na página de discussão. Favor não use na página de discussão de artigos.");
			}
		}
		
		function changeLog(){
			alert(whatsnew);
		}
		
		function inviteToTeahouse(){
			if ( mw.config.get( 'wgCanonicalNamespace' ) === 'Usuário(a)_Discussão') {
				if (confirm("Gostaria de agradeçer pelo o agradecimento?")) {
					appendToPage({
						title: mw.config.get('wgPageName'),
						text: bloqueia.agradecimento,
						summary: es.agradecimento
					});
				}
				wait(3);
			}
			
			else {
				alert("TTUT: Esta ferramenta só pode ser usada na página de discussão. Favor não use na página de discussão de artigos.");
			}
		}
		
		function userEditCount(){
			let username = mw.config.get("wgPageName");
			let type;
			username = username.split(":")[0];
			username = username.split("/")[0];
			let contribPage = `Special:Contributions/${username}`;
		}
		
		function customWarning(){
			warning = window.prompt("Favor digite uma mensagem do aviso personalizado:");
			console.log("Warning contents: " + warning);
			let levels = ["1", "2", "3", "4"];
			let level_msg = `Escolhe o nivel do aviso:
1: Boa fé assumida
2: No faith assumida
3: Má fé assumida, terceiro aviso
4: Má fé assumida, ultimo ou unico aviso`;
			let level = window.prompt(level_msg);
			while (!levels.includes(level)){
				alert("TTUT: Nivel inválido");
				level = window.prompt(level_msg);
			}
			let block;
			if (level == "1"){
				block = blocks.warning1;
			} else if (level == "2"){
				block = blocks.warning2;
			} else if (level == "3"){
				block = blocks.warning3;
			} else if (level == "4"){
				block = blocks.warning4;
			}
			
			block = block.replace("%WARNING%", warning);
			
			block = block + blocks.warninggeneric;
			console.log("Wikitext blurb for warning: " + block);
			if (confirm("Gostaria de enviar o aviso personalizado? VOCê SERÁ O RESPONSAVEL DE SEGUIR TODAS AS REGRAS USANDO ESTA TRADUÇÃO DO SCRIPT SCRIPT.")){
				appendToPage({
					title: mw.config.get("wgPageName"),	
					text: block,
					summary: es.custom
				});
				wait(3);
			}
		}
		
		mw.util.addPortlet('p-ttut', 'TTUT', '#p-cactions');
		if ( mw.config.get( 'wgCanonicalNamespace' ) === 'User_talk') {
			smile_button = mw.util.addPortletLink(portletId='p-ttut', href='#', text=':)', tooltip="Enviar um sorriso");
			$(smile_button).on("click", function(e) {
				smileAtUser();
				e.preventDefault();
			});
			teahouse = mw.util.addPortletLink(portletId='p-ttut', href='#', text='Agradeçer', tooltip="Agradeçer pelo o usuário");
			$(teahouse).on("click", function(e) {
				inviteToTeahouse();
				e.preventDefault();
			});
			custom = mw.util.addPortletLink(portletId='p-ttut', href="#", text="Aviso", tooltip="Enviar um aviso personalizado");
			$(custom).on("click", function(e) {
				customWarning();
				e.preventDefault();
			})
		} else if (mw.config.get("wgCanonicalNamespace") === ""){}
		whatsnew_button = mw.util.addPortletLink(portletId="p-ttut", href="#", text="QN?", tooltip="Veja qual é a novidade!");
		$(whatsnew_button).on("click", function(e) {
			changeLog();
			e.preventDefault();
		})
	});
});
